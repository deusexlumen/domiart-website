{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "domiart-website.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
