---
import Base from '../layouts/Base.astro';
---
<Base
  title="DOMIART — Modernisierung, Renovierung & Sanierung in Dortmund"
  description="Generalunternehmen in Dortmund für Modernisierung, Renovierung und Sanierung: Innenausbau, Trockenbau, Fliesen, Maler, Verputz. ☎ 0155 68820575"
  canonical="https://www.domiart-moresa.de/"
  ogTitle="DOMIART — Modernisierung aller Art in Dortmund"
  ogDescription="Sanierung, Renovierung & Modernisierung aus einer Hand. Trockenbau · Maler · Verputz · Innenausbau · Entkernung · Entrümpelung. Wir betreuen Ihr Projekt, als wäre es unser eigenes."
>
  <!-- Hero-Poster ist das LCP-Element -->
  <link rel="preload" as="image" href="/assets/img/scheune-nachher-poster.webp" fetchpriority="high" slot="head">

  <!-- Strukturierte Daten: FAQ -->
  <script type="application/ld+json" is:inline slot="head">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Muss ich während der Arbeiten ausziehen?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "In der Regel nicht. Wir arbeiten mit Rücksicht auf Ihr Zuhause: Bereiche werden sauber abgedeckt, Wege freigehalten und die Baustelle täglich ordentlich hinterlassen."
        }
      },
      {
        "@type": "Question",
        "name": "Kann ich auch nur einzelne Gewerke beauftragen?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja. Ob nur Malerarbeiten, Trockenbau, Verputz oder eine Entrümpelung — Sie können jede Leistung einzeln beauftragen oder das Komplettpaket aus einer Hand wählen."
        }
      },
      {
        "@type": "Question",
        "name": "In welchem Gebiet arbeitet DOMIART?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Wir sind in Dortmund und Umgebung im gesamten Ruhrgebiet für Sie im Einsatz — persönlich vor Ort, von der ersten Beratung bis zur Übergabe."
        }
      }
    ]
  }
  </script>

    <!-- ================= Hero: Scheune Vorher/Nachher ================= -->
    <!-- Ein <video>, zwei Quellen: der Umschalter tauscht src + poster   -->
    <!-- (main.js, .video-frame). Nie zwei Videos gleichzeitig decodiert. -->
    <section id="vorher-nachher" class="hero hero--video">
      <div class="hero__bg" aria-hidden="true"><div class="hero__glow"></div></div>

      <div class="container">
        <div class="hero__content">
          <p class="eyebrow eyebrow--light" data-reveal>Generalunternehmen · Dortmund</p>
          <h1 class="display-xl" data-reveal>
            Modernisierung<br>
            <span class="accent">aller Art.</span>
          </h1>
        </div>

        <div class="video-frame hero__video" data-reveal>
          <video src="/assets/video/scheune-nachher.mp4" playsinline loop muted preload="metadata"
                 poster="/assets/img/scheune-nachher-poster.webp"
                 width="636" height="360"
                 aria-label="Scheunenausbau von DOMIART im Video"></video>
          <div class="video-frame__bar">
            <button class="video-frame__btn" aria-label="Video abspielen / pausieren">
              <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor" style="display:none"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
            </button>
            <div class="video-switch" role="group" aria-label="Scheunenausbau: Vorher oder Nachher zeigen">
              <button type="button" class="video-switch__opt" aria-pressed="false"
                data-src="/assets/video/scheune-vorher.mp4"
                data-poster="/assets/img/scheune-vorher-poster.webp">Vorher</button>
              <button type="button" class="video-switch__opt is-active" aria-pressed="true"
                data-src="/assets/video/scheune-nachher.mp4"
                data-poster="/assets/img/scheune-nachher-poster.webp">Nachher</button>
            </div>
          </div>
        </div>

        <div class="hero__claim">
          <p class="lead lead--light hero__sub" data-reveal>
            Aus einer alten Scheune wurde Wohnraum — kompletter Ausbau,
            alles aus einer Hand.
          </p>
          <div class="hero__actions" data-reveal>
            <a href="/#anfrage" class="btn btn--primary">
              Ihr Projekt anfragen
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="tel:+4915568820575" class="btn btn--ghost">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              0155 68820575
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= Drei Beweise ================= -->
    <section class="trust-band" aria-label="Unsere Versprechen">
      <div class="container">
        <ul class="trust-band__grid trust-band__grid--3">
          <li data-reveal>
            <span class="trust-band__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </span>
            <div>
              <strong>Inhaber persönlich</strong>
              <span>Ein Ansprechpartner für alles</span>
            </div>
          </li>
          <li data-reveal data-reveal-delay="0.08">
            <span class="trust-band__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </span>
            <div>
              <strong>Dortmund &amp; Umgebung</strong>
              <span>Persönlich vor Ort, von Anfang bis Übergabe</span>
            </div>
          </li>
          <li data-reveal data-reveal-delay="0.16">
            <span class="trust-band__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 15l2 2 4-4"/></svg>
            </span>
            <div>
              <strong>Festpreis-Angebot</strong>
              <span>Keine versteckten Kosten · besenreine Übergabe</span>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <!-- ================= Bewertungen (statisch, cookie-frei) ================= -->
    <!-- Texte woertlich aus dem Google-Unternehmensprofil, gekuerzt.     -->
    <!-- Kein iframe, kein Widget, keine Google-Bilder. Bei neuen          -->
    <!-- Bewertungen: nur echte Texte aus dem Profil uebernehmen.         -->
    <section class="reviews" aria-labelledby="reviews-title">
      <div class="container">
        <div class="reviews__head">
          <h2 id="reviews-title" class="eyebrow">Bewertungen auf Google</h2>
          <p class="reviews__score">
            <span class="stars" role="img" aria-label="5 von 5 Sternen">★★★★★</span>
            5,0 · 4 Bewertungen
          </p>
        </div>
        <ul class="reviews__list">
          <li class="review" data-reveal>
            <span class="stars" role="img" aria-label="5 von 5 Sternen">★★★★★</span>
            <blockquote class="review__text">
              <p>„Wir haben unser Haus (Altbau) komplett von Herr Polaczek als Generalunternehmer modernisieren lassen. […] Wir mussten uns um nichts mehr kümmern.“</p>
            </blockquote>
            <p class="review__meta">Ser D. · 2025 · Google</p>
          </li>
          <li class="review" data-reveal data-reveal-delay="0.08">
            <span class="stars" role="img" aria-label="5 von 5 Sternen">★★★★★</span>
            <blockquote class="review__text">
              <p>„Top Arbeit und sehr gutes Preis-Leistungsverhältnis. Immer wieder gerne.“</p>
            </blockquote>
            <p class="review__meta">Michael S. · 2025 · Google</p>
          </li>
          <li class="review" data-reveal data-reveal-delay="0.16">
            <span class="stars" role="img" aria-label="5 von 5 Sternen">★★★★★</span>
            <blockquote class="review__text">
              <p>„Zuverlässige Arbeit, gutes Preis-Leistungsverhältnis, mit gutem Gewissen zu empfehlen.“</p>
            </blockquote>
            <p class="review__meta">Aziz D. · 2025 · Google</p>
          </li>
        </ul>
        <a class="reviews__link" href="https://www.google.com/maps?cid=5260059026546612538" target="_blank" rel="noopener">
          Alle Bewertungen auf Google →
        </a>
      </div>
    </section>

    <!-- ================= Inhaber & Über uns ================= -->
    <section id="ueber-uns" class="section section--off about">
      <div class="container">
        <div class="about__media" data-reveal>
          <img src="/assets/img/leistungen/renovierung-vorher.webp" width="945" height="533"
               alt="Adrian Polaczek stemmt mit Stemmhammer und Staubmaske eine Wand auf" loading="lazy">
          <blockquote class="about__quote">
            „Wir betreuen Ihr Projekt, als wäre es unser eigenes."
            <footer>— Adrian Polaczek, Inhaber DOMIART</footer>
          </blockquote>
        </div>

        <div class="about__copy" data-reveal>
          <p class="eyebrow">Inhabergeführt</p>
          <h2 class="display-lg">Der Chef steht<br>selbst auf der Baustelle.</h2>
          <p class="lead">
            DOMIART ist Ihr Generalunternehmen in Dortmund — geführt von
            Adrian Polaczek, der jedes Projekt persönlich betreut.
          </p>
          <ol class="about__steps">
            <li><strong>Beratung vor Ort</strong> — kostenlos und unverbindlich.</li>
            <li><strong>Transparentes Angebot</strong> — mit allen Positionen.</li>
            <li><strong>Saubere Umsetzung</strong> — termintreu, mit Rücksicht auf Ihr Zuhause.</li>
          </ol>
        </div>
      </div>
    </section>

    <!-- ================= Handwerk: Fliesen im Laeuferverband ================= -->
    <section class="tile-band" aria-label="Handwerk">
      <img class="tile-band__photo" src="/assets/img/fliesen-laeuferverband.webp" width="1102" height="850"
           alt="Glasierte Terrakotta-Fliesen im Läuferverband, sauber geschnitten und verfugt" loading="lazy">
      <div class="container">
        <p class="eyebrow eyebrow--light" data-reveal>Handwerk</p>
        <p class="tile-band__line" data-reveal>
          Sauber geschnitten.<br><span class="accent">Sauber verfugt.</span>
        </p>
      </div>
    </section>

    <!-- ================= Projekt-Konfigurator ================= -->
    <section id="anfrage" class="section section--off configurator configurator--tight">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Projekt-Anfrage in 30 Sekunden</p>
          <h2 class="display-lg">Sagen Sie uns,<br>was Sie vorhaben.</h2>
          <p class="lead">
            Drei kurze Fragen — wir melden uns mit einer ehrlichen
            Ersteinschätzung.
          </p>
        </div>

        <div class="config" data-reveal>
          <div class="config__progress">
            <span class="config__step-label">Schritt <b data-step-current>1</b> von 3</span>
            <div class="config__dots" aria-hidden="true">
              <span class="is-active"></span><span></span><span></span>
            </div>
          </div>

          <div class="config__panels">
            <!-- Schritt 1: Bereich -->
            <div class="config__panel is-active" data-step="1">
              <h3>Was möchten Sie modernisieren?</h3>
              <div class="config__options">
                <button type="button" class="config__option" data-field="bereich" data-value="Bad / Gäste-WC">Bad / Gäste-WC</button>
                <button type="button" class="config__option" data-field="bereich" data-value="Wohnräume">Wohnräume</button>
                <button type="button" class="config__option" data-field="bereich" data-value="Keller / Dachboden">Keller / Dachboden</button>
                <button type="button" class="config__option" data-field="bereich" data-value="Komplette Immobilie">Komplette Immobilie</button>
                <button type="button" class="config__option" data-field="bereich" data-value="Entkernung / Entrümpelung">Entkernung / Entrümpelung</button>
              </div>
            </div>

            <!-- Schritt 2: Umfang + Zustand -->
            <div class="config__panel" data-step="2">
              <h3>Wie groß ist der Bereich ungefähr?</h3>
              <div class="config__options">
                <button type="button" class="config__option" data-field="groesse" data-value="bis 5 m²">bis 5 m²</button>
                <button type="button" class="config__option" data-field="groesse" data-value="5–15 m²">5–15 m²</button>
                <button type="button" class="config__option" data-field="groesse" data-value="15–30 m²">15–30 m²</button>
                <button type="button" class="config__option" data-field="groesse" data-value="über 30 m²">über 30 m²</button>
                <button type="button" class="config__option" data-field="groesse" data-value="weiß ich nicht genau">weiß ich nicht genau</button>
              </div>
              <h3 class="config__sub">In welchem Zustand ist die Immobilie?</h3>
              <div class="config__options">
                <button type="button" class="config__option" data-field="zustand" data-value="Altbau">Altbau</button>
                <button type="button" class="config__option" data-field="zustand" data-value="teilsaniert">teilsaniert</button>
                <button type="button" class="config__option" data-field="zustand" data-value="Rohbau / Neubau">Rohbau / Neubau</button>
              </div>
            </div>

            <!-- Schritt 3: Zeitpunkt + Name + Zusammenfassung -->
            <div class="config__panel" data-step="3">
              <h3>Wann soll es losgehen?</h3>
              <div class="config__options">
                <button type="button" class="config__option" data-field="zeitpunkt" data-value="so schnell wie möglich">so schnell wie möglich</button>
                <button type="button" class="config__option" data-field="zeitpunkt" data-value="in 1–3 Monaten">in 1–3 Monaten</button>
                <button type="button" class="config__option" data-field="zeitpunkt" data-value="in mehr als 3 Monaten">in mehr als 3 Monaten</button>
                <button type="button" class="config__option" data-field="zeitpunkt" data-value="erst mal nur beraten lassen">erst mal nur beraten</button>
              </div>

              <label class="config__name">
                <span>Ihr Name (optional)</span>
                <input type="text" data-field="name" placeholder="z. B. Max Mustermann" autocomplete="name">
              </label>

              <div class="config__summary" aria-live="polite">
                <span class="config__summary-label">Ihre Nachricht an uns:</span>
                <p data-summary>Wählen Sie oben einen Zeitpunkt — Ihre Nachricht entsteht hier.</p>
              </div>
            </div>
          </div>

          <div class="config__footer">
            <button type="button" class="btn btn--dark config__back" data-back disabled>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
              Zurück
            </button>
            <button type="button" class="btn btn--dark config__next" data-next disabled>
              Weiter
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
            <a href="#" class="btn btn--primary config__send" data-send target="_blank" rel="noopener" hidden>
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm5.83 14.12c-.25.7-1.45 1.33-2.02 1.42-.52.08-1.17.11-1.89-.12a17.6 17.6 0 0 1-1.71-.63c-3.01-1.3-4.97-4.33-5.12-4.53-.15-.2-1.22-1.63-1.22-3.11 0-1.48.77-2.2 1.05-2.51.27-.3.6-.38.8-.38.2 0 .4 0 .57.01.18.01.43-.07.67.51.25.6.85 2.07.92 2.22.08.15.13.33.03.53-.1.2-.15.33-.3.5-.15.18-.32.4-.45.53-.15.15-.31.31-.13.61.18.3.79 1.31 1.7 2.12 1.17 1.04 2.16 1.37 2.46 1.52.3.15.48.13.65-.08.18-.2.75-.87.95-1.17.2-.3.4-.25.67-.15.28.1 1.75.83 2.05.98.3.15.5.22.57.35.08.12.08.72-.17 1.42z"/></svg>
              Per WhatsApp senden
            </a>
          </div>
          <p class="config__alt">Lieber direkt? <a href="tel:+4915568820575">0155 68820575 anrufen</a> — wir beraten Sie sofort.</p>
        </div>
      </div>
    </section>

    <!-- ================= Projekte ================= -->
    <section id="projekte" class="section section--dark">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow eyebrow--light">Ausgewählte Projekte</p>
          <h2 class="display-lg">Echte Arbeit.<br>Echte Ergebnisse.</h2>
        </div>

        <div class="gallery-grid gallery-grid--trio gallery-grid--home">
          <button type="button" class="gallery-item" data-reveal aria-label="Bild vergrößern: Sanierte Altbau-Diele mit Doppeltür">
            <img src="/assets/img/projekte/projekt-2.webp" width="900" height="1857" alt="Sanierte Altbau-Diele — die alte Doppeltür mit Glaseinsätzen bleibt als Charakterstück erhalten" loading="lazy">
            <span class="gallery-item__cat">Altbau-Diele · Doppeltür erhalten</span>
          </button>
          <button type="button" class="gallery-item" data-reveal data-reveal-delay="0.08" aria-label="Bild vergrößern: Das große Bad — Fugenbild und gerade eingeputzte Abschlussschiene">
            <img src="/assets/img/projekte/projekt-4.webp" width="1600" height="1079" alt="Das große Bad im Detail: durchlaufendes Fugenbild und die schnurgerade eingeputzte Abschlussschiene über den Wandfliesen" loading="lazy">
            <span class="gallery-item__cat">Das große Bad</span>
          </button>
          <button type="button" class="gallery-item" data-reveal data-reveal-delay="0.16" aria-label="Bild vergrößern: Millimetergenauer Vinylboden-Abschluss an der Türzarge">
            <img src="/assets/img/projekte/boden-zarge-praezision.webp" width="908" height="2016" alt="Millimetergenauer Vinylboden-Abschluss an der Türzarge" loading="lazy">
            <span class="gallery-item__cat">Bodenbeläge</span>
          </button>
        </div>
      </div>
    </section>

    <!-- ================= Leistungen (kompakt) ================= -->
    <section id="leistungen" class="services-line" aria-labelledby="leistungen-title">
      <div class="container">
        <h2 id="leistungen-title" class="eyebrow">Unsere Leistungen</h2>
        <ul class="services-line__list">
          <li>Modernisierung</li>
          <li><a href="/renovierung-dortmund/">Renovierung</a></li>
          <li>Sanierung</li>
          <li>Innenausbau</li>
          <li><a href="/fliesenarbeiten-dortmund/">Fliesenarbeiten</a></li>
          <li><a href="/trockenbau-dortmund/">Trockenbau</a></li>
          <li>Malerarbeiten</li>
          <li>Verputzarbeiten</li>
          <li>Tapezierarbeiten</li>
          <li>Entkernung &amp; Entrümpelung</li>
        </ul>
      </div>
    </section>

    <!-- ================= FAQ ================= -->
    <section id="faq" class="section">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Häufige Fragen</p>
          <h2 class="display-lg">Gut zu wissen.</h2>
        </div>

        <div class="faq-list" data-reveal>
          <details class="faq-item">
            <summary>
              Muss ich während der Arbeiten ausziehen?
              <span class="faq-item__icon" aria-hidden="true"></span>
            </summary>
            <div class="faq-item__body">
              <p>In der Regel nicht. Wir arbeiten mit Rücksicht auf Ihr Zuhause: Bereiche werden sauber abgedeckt, Wege freigehalten und die Baustelle täglich ordentlich hinterlassen.</p>
            </div>
          </details>
          <details class="faq-item">
            <summary>
              Kann ich auch nur einzelne Gewerke beauftragen?
              <span class="faq-item__icon" aria-hidden="true"></span>
            </summary>
            <div class="faq-item__body">
              <p>Ja. Ob nur Malerarbeiten, Trockenbau, Verputz oder eine Entrümpelung — Sie können jede Leistung einzeln beauftragen oder das Komplettpaket aus einer Hand wählen.</p>
            </div>
          </details>
          <details class="faq-item">
            <summary>
              In welchem Gebiet arbeitet DOMIART?
              <span class="faq-item__icon" aria-hidden="true"></span>
            </summary>
            <div class="faq-item__body">
              <p>Wir sind in Dortmund und Umgebung im gesamten Ruhrgebiet für Sie im Einsatz — persönlich vor Ort, von der ersten Beratung bis zur Übergabe.</p>
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- ================= Kontakt ================= -->
    <section id="kontakt" class="section section--dark contact">
      <div class="contact__glow" aria-hidden="true"></div>
      <div class="container">
        <div class="contact__grid">
          <div data-reveal>
            <p class="eyebrow eyebrow--light">Kontakt</p>
            <h2 class="display-lg">Lassen Sie sich<br>noch heute beraten.</h2>
            <p class="lead lead--light">
              Erzählen Sie uns von Ihrem Vorhaben — wir melden uns schnell
              zurück und finden einen Termin für eine kostenlose Beratung
              vor Ort.
            </p>
            <a href="tel:+4915568820575" class="contact__phone">0155 68820575</a>
            <p class="contact__note">Auch per WhatsApp erreichbar — schreiben Sie uns einfach.</p>
