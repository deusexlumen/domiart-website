---
import Base from '../layouts/Base.astro';
---
<Base
  title="Entkernung &amp; Entrümpelung in Dortmund — DOMIART"
  description="Entkernung und Entrümpelung in Dortmund von DOMIART: fachgerechter Rückbau, Entsorgung und besenreine Übergabe aus einer Hand. Kostenlose Besichtigung & Festpreis-Angebot. ☎ 0155 68820575"
  canonical="https://www.domiart-moresa.de/entkernung-entruempelung-dortmund"
  ogTitle="Entkernung &amp; Entrümpelung in Dortmund — DOMIART"
  ogDescription="Wir schaffen Platz für Neues: fachgerechte Entkernung, Entrümpelung und Entsorgung in Dortmund — schnell und besenrein."
  ogImage="/assets/img/og-entkernung.jpg"
>
  <!-- Strukturierte Daten: Breadcrumb -->
  <script type="application/ld+json" is:inline slot="head">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Startseite",
        "item": "https://www.domiart-moresa.de/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Entkernung & Entrümpelung Dortmund",
        "item": "https://www.domiart-moresa.de/entkernung-entruempelung-dortmund"
      }
    ]
  }
  </script>

  <!-- Strukturierte Daten: Service -->
  <script type="application/ld+json" is:inline slot="head">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Entkernung und Entrümpelung",
    "provider": {
      "@type": "GeneralContractor",
      "name": "DOMIART — Adrian Polaczek",
      "url": "https://www.domiart-moresa.de/",
      "telephone": "+49 155 68820575",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Altumstr. 1",
        "postalCode": "44265",
        "addressLocality": "Dortmund",
        "addressCountry": "DE"
      }
    },
    "areaServed": {
      "@type": "City",
      "name": "Dortmund"
    },
    "description": "Entkernung und Entrümpelung in Dortmund aus einer Hand: fachgerechter Rückbau, Haushaltsauflösungen und Entsorgung — schnell und besenrein."
  }
  </script>

    <!-- ================= Sub-Hero ================= -->
    <section class="subhero">
      <div class="hero__bg" aria-hidden="true"><div class="hero__glow"></div></div>
      <div class="container">
        <p class="eyebrow eyebrow--light" data-reveal>Entkernung &amp; Entrümpelung · Dortmund &amp; Umgebung</p>
        <h1 class="display-xl" data-reveal>
          Entkernung &amp; Entrümpelung<br>
          <span class="accent">Platz für Neues.</span>
        </h1>
        <p class="lead lead--light subhero__sub" data-reveal>
          Fachgerechter Rückbau, Haushaltsauflösungen und Entsorgung — DOMIART
          schafft in Dortmund schnell und besenrein Platz für Ihr neues
          Projekt.
        </p>
        <div class="hero__actions" data-reveal>
          <a href="tel:+4915568820575" class="btn btn--primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            0155 68820575 anrufen
          </a>
          <a href="https://wa.me/4915568820575?text=Hallo%20DOMIART%2C%20ich%20interessiere%20mich%20f%C3%BCr%20eine%20Entkernung%2FEntr%C3%BCmpelung." class="btn btn--ghost" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm5.83 14.12c-.25.7-1.45 1.33-2.02 1.42-.52.08-1.17.11-1.89-.12a17.6 17.6 0 0 1-1.71-.63c-3.01-1.3-4.97-4.33-5.12-4.53-.15-.2-1.22-1.63-1.22-3.11 0-1.48.77-2.2 1.05-2.51.27-.3.6-.38.8-.38.2 0 .4 0 .57.01.18.01.43-.07.67.51.25.6.85 2.07.92 2.22.08.15.13.33.03.53-.1.2-.15.33-.3.5-.15.18-.32.4-.45.53-.15.15-.31.31-.13.61.18.3.79 1.31 1.7 2.12 1.17 1.04 2.16 1.37 2.46 1.52.3.15.48.13.65-.08.18-.2.75-.87.95-1.17.2-.3.4-.25.67-.15.28.1 1.75.83 2.05.98.3.15.5.22.57.35.08.12.08.72-.17 1.42z"/></svg>
            Per WhatsApp anfragen
          </a>
        </div>
      </div>
    </section>

    <!-- ================= Intro ================= -->
    <section class="section">
      <div class="container prose" data-reveal>
        <p>
          Bevor etwas Neues entstehen kann, muss oft erst Platz geschaffen
          werden: alte Fliesen, ausgediente Möbel, ein voller Keller oder
          eine komplette Wohnungsauflösung. Genau da beginnt unsere Arbeit.
        </p>
        <p>
          Als Generalunternehmen aus Dortmund übernimmt DOMIART Entkernung
          und Entrümpelung fachgerecht und mit ordnungsgemäßer Entsorgung —
          egal ob als Vorbereitung für Ihre Sanierung oder als eigenständiger
          Auftrag. Ein Ansprechpartner, ein fester Termin.
        </p>
      </div>
    </section>

    <!-- ================= Leistungsumfang ================= -->
    <section class="section section--off">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Leistungsumfang</p>
          <h2 class="display-lg">Entkernung &amp; Entrümpelung —<br>komplett aus einer Hand.</h2>
          <p class="lead">
            Diese Arbeiten decken wir ab. Sie müssen keinen einzigen
            weiteren Handwerker koordinieren.
          </p>
        </div>

        <ul class="about__list" data-reveal>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            Entkernung als Vorbereitung für Ihre Sanierung
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            Haushaltsauflösungen von der Wohnung bis zum Keller
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            Fachgerechte Entsorgung nach Vorschrift
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            Räumung von Keller, Dachboden und Garage
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            Besenreine Übergabe nach Abschluss
          </li>
        </ul>
      </div>
    </section>

    <div class="fugen-strip" aria-hidden="true"></div>

    <!-- ================= Einblicke ================= -->
    <section class="section section--dark">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow eyebrow--light">Einblicke</p>
          <h2 class="display-lg">Wir schaffen Platz<br>für das Neue.</h2>
        </div>

        <div class="gallery-grid gallery-grid--duo">
          <button type="button" class="gallery-item" data-reveal aria-label="Bild vergrößern: Wanddurchbruch während der Entkernung">
            <img src="/assets/img/leistungen/entkernung-durchbruch.webp" alt="Wanddurchbruch während der Entkernung — kontrolliert gestemmt, Bauschutt direkt aufgenommen" loading="lazy">
            <span class="gallery-item__cat">Durchbruch</span>
          </button>
          <button type="button" class="gallery-item" data-reveal data-reveal-delay="0.08" aria-label="Bild vergrößern: Vollständig entkerntes Badezimmer">
            <img src="/assets/img/leistungen/entkernung-bad.webp" alt="Vollständig entkerntes Badezimmer — alte Fliesen und Sanitärobjekte entfernt, bereit für den Neuaufbau" loading="lazy">
            <span class="gallery-item__cat">Entkernt</span>
          </button>
        </div>
      </div>
    </section>

    <!-- ================= Ablauf ================= -->
    <section class="section section--dark">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow eyebrow--light">Der Ablauf</p>
          <h2 class="display-lg">So laufen Entkernung<br>&amp; Entrümpelung ab.</h2>
        </div>

        <div class="steps-grid">
          <article class="step-card" data-reveal>
            <p class="step-card__num">01</p>
            <h3>Besichtigung &amp; Planung</h3>
            <p>Wir schauen uns die Räume in Dortmund vor Ort an und schätzen Umfang und Aufwand ein — kostenlos und unverbindlich.</p>
          </article>
          <article class="step-card" data-reveal data-reveal-delay="0.08">
            <p class="step-card__num">02</p>
            <h3>Festpreis-Angebot</h3>
            <p>Sie erhalten ein transparentes Angebot mit allen Positionen und einem verbindlichen Termin.</p>
          </article>
          <article class="step-card" data-reveal data-reveal-delay="0.16">
            <p class="step-card__num">03</p>
            <h3>Rückbau &amp; Räumung</h3>
            <p>Rückbau, Räumung und Abtransport — zügig und mit Rücksicht auf Nachbarn und angrenzende Bereiche.</p>
          </article>
          <article class="step-card" data-reveal data-reveal-delay="0.24">
            <p class="step-card__num">04</p>
            <h3>Übergabe</h3>
            <p>Besenreine Übergabe — bereit für Ihre Sanierung oder Neuvermietung.</p>
          </article>
        </div>
      </div>
    </section>

    <div class="fugen-strip" aria-hidden="true"></div>

    <!-- ================= FAQ ================= -->
    <section class="section">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Häufige Fragen</p>
          <h2 class="display-lg">Fragen zu Entkernung &amp; Entrümpelung.</h2>
        </div>

        <div class="faq-list" data-reveal>
          <details class="faq-item">
            <summary>
              Wie schnell ist eine Wohnung entrümpelt?
              <span class="faq-item__icon" aria-hidden="true"></span>
            </summary>
            <div class="faq-item__body">
              <p>Eine normal möblierte Wohnung ist häufig innerhalb eines Tages geräumt. Bei größeren Objekten oder Häusern planen wir gemeinsam einen realistischen Zeitrahmen.</p>
            </div>
          </details>
          <details class="faq-item">
            <summary>
              Übernehmen Sie auch die Entsorgung?
              <span class="faq-item__icon" aria-hidden="true"></span>
            </summary>
            <div class="faq-item__body">
              <p>Ja. Rückbau, Abtransport und fachgerechte Entsorgung sind bei uns immer im Leistungsumfang enthalten — Sie müssen sich um nichts selbst kümmern.</p>
            </div>
          </details>
          <details class="faq-item">
            <summary>
              Ist eine Besichtigung vor dem Angebot nötig?
              <span class="faq-item__icon" aria-hidden="true"></span>
            </summary>
            <div class="faq-item__body">
              <p>Ja, damit wir Umfang und Aufwand richtig einschätzen können. Die Besichtigung ist kostenlos und unverbindlich.</p>
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- ================= Kontakt-CTA ================= -->
    <section class="section section--dark contact">
      <div class="contact__glow" aria-hidden="true"></div>
      <div class="container">
        <div class="contact__grid">
          <div data-reveal>
            <p class="eyebrow eyebrow--light">Kostenlose Besichtigung</p>
            <h2 class="display-lg">Entkernung oder Entrümpelung<br>in Dortmund? Reden wir darüber.</h2>
            <p class="lead lead--light">
              Rufen Sie an oder schreiben Sie uns per WhatsApp — wir
              vereinbaren eine kostenlose Besichtigung und Sie erhalten ein
              transparentes Festpreis-Angebot.
            </p>
            <a href="tel:+4915568820575" class="contact__phone">0155 68820575</a>
            <p class="contact__note">Auch per WhatsApp erreichbar — schreiben Sie uns einfach.</p>
            <div class="hero__actions">
              <a href="https://wa.me/4915568820575?text=Hallo%20DOMIART%2C%20ich%20interessiere%20mich%20f%C3%BCr%20eine%20Entkernung%2FEntr%C3%BCmpelung." class="btn btn--primary" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm5.83 14.12c-.25.7-1.45 1.33-2.02 1.42-.52.08-1.17.11-1.89-.12a17.6 17.6 0 0 1-1.71-.63c-3.01-1.3-4.97-4.33-5.12-4.53-.15-.2-1.22-1.63-1.22-3.11 0-1.48.77-2.2 1.05-2.51.27-.3.6-.38.8-.38.2 0 .4 0 .57.01.18.01.43-.07.67.51.25.6.85 2.07.92 2.22.08.15.13.33.03.53-.1.2-.15.33-.3.5-.15.18-.32.4-.45.53-.15.15-.31.31-.13.61.18.3.79 1.31 1.7 2.12 1.17 1.04 2.16 1.37 2.46 1.52.3.15.48.13.65-.08.18-.2.75-.87.95-1.17.2-.3.4-.25.67-.15.28.1 1.75.83 2.05.98.3.15.5.22.57.35.08.12.08.72-.17 1.42z"/></svg>
                WhatsApp schreiben
              </a>
              <a href="mailto:info@domiart-moresa.de" class="btn btn--ghost">
                E-Mail senden
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>

          <div class="contact-cards" data-reveal>
            <a href="tel:+4915568820575" class="contact-card">
              <span class="contact-card__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </span>
              <div>
                <strong>Telefon &amp; WhatsApp</strong>
                <span>0155 68820575 — wir rufen auch gern zurück</span>
              </div>
            </a>
            <a href="mailto:info@domiart-moresa.de" class="contact-card">
              <span class="contact-card__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
              </span>
              <div>
                <strong>E-Mail</strong>
                <span>info@domiart-moresa.de — Antwort in der Regel am selben Tag</span>
              </div>
            </a>
            <div class="contact-card">
              <span class="contact-card__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </span>
              <div>
                <strong>Adresse</strong>
                <span>Altumstr. 1 · 44265 Dortmund</span>
              </div>
            </div>
            <div class="contact-card">
              <span class="contact-card__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              </span>
              <div>
                <strong>Erreichbarkeit</strong>
                <span>Mo–Sa nach Vereinbarung — Termine auch abends möglich</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
</Base>
