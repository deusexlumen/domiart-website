---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import StickyCta from '../components/StickyCta.astro';
import Preloader from '../components/Preloader.astro';

interface Props {
  title: string;
  description: string;
  /* Optional nur fuer die 404-Seite: ohne Angabe kein Canonical/og:url. */
  canonical?: string;
  robots?: string;
  ogTitle?: string;
  ogDescription?: string;
  /* Seiten ohne Animationen (Impressum, Datenschutz) koennen den      */
  /* Vendor-Stack (Lenis, GSAP, ScrollTrigger, SplitText) abklemmen.   */
  vendorScripts?: boolean;
  /* Seitenspezifisches Social-Preview (1200x630, bewusst JPEG wegen  */
  /* Crawler-Kompatibilitaet). Ohne Angabe das generische Markenbild. */
  ogImage?: string;
}

const {
  title,
  description,
  canonical,
  robots = 'index, follow',
  ogTitle = title,
  ogDescription = description,
  ogImage = '/assets/img/og-image.jpg',
  vendorScripts = true,
} = Astro.props;

const ogImageUrl = new URL(ogImage, 'https://www.domiart-moresa.de/').href;
---
<!DOCTYPE html>
<html lang="de" class="no-js">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="author" content="DOMIART — Adrian Polaczek">
  <meta name="robots" content={robots}>
  {canonical && <link rel="canonical" href={canonical}>}

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:locale" content="de_DE">
  <meta property="og:title" content={ogTitle}>
  <meta property="og:description" content={ogDescription}>
  {canonical && <meta property="og:url" content={canonical}>}
  <meta property="og:image" content={ogImageUrl}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content={ogImageUrl}>

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/assets/img/favicon.png">

  <!-- Font-Preload: kritische Schnitte fuer H1 (LCP) und Fliesstext, -->
  <!-- damit der erste Paint nicht auf System-Fonts zurueckfaellt.    -->
  <link rel="preload" href="/assets/fonts/BricolageGrotesque-700-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/Inter-400-latin.woff2" as="font" type="font/woff2" crossorigin>

  <!-- Fonts (lokal, DSGVO-konform) -->
  <link rel="stylesheet" href="/assets/fonts/fonts.css">

  <!-- Styles -->
  <link rel="stylesheet" href="/css/styles.css">

  <!-- Strukturierte Daten: Lokales Unternehmen -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "GeneralContractor",
    "name": "DOMIART — Adrian Polaczek",
    "description": "Generalunternehmen in Dortmund für Modernisierung, Renovierung, Sanierung, Trockenbau, Malerarbeiten, Verputzarbeiten, Innenausbau, Entkernung und Entrümpelung.",
    "url": "https://www.domiart-moresa.de/",
    "telephone": "+49 155 68820575",
    "email": "info@domiart-moresa.de",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Altumstr. 1",
      "postalCode": "44265",
      "addressLocality": "Dortmund",
      "addressCountry": "DE"
    },
    "areaServed": ["Dortmund", "Ruhrgebiet", "Nordrhein-Westfalen"],
    "image": "https://www.domiart-moresa.de/assets/img/og-image.jpg",
    "sameAs": [
      "https://www.facebook.com/profile.php?id=100090384174074"
    ],
    "knowsAbout": [
      "Modernisierung", "Renovierung", "Sanierung", "Fliesenarbeiten", "Tapezierarbeiten",
      "Trockenbau", "Malerarbeiten", "Verputzarbeiten", "Innenausbau",
      "Entkernung", "Entrümpelung"
    ],
    "slogan": "Wir betreuen Ihr Projekt, als wäre es unser eigenes."
  }
  </script>

  <slot name="head" />

  <!-- Preloader-Entscheidung vor dem ersten Paint: nur beim Einstieg   -->
  <!-- von aussen (nicht bei Navigation innerhalb der Seite) und nur bei -->
  <!-- voller Motion. Bewusst ohne sessionStorage: Speichern auf dem     -->
  <!-- Endgeraet waere nach § 25 TDDDG einwilligungspflichtig.           -->
  <script is:inline>
    (function () {
      try {
        var internal = false;
        if (document.referrer) {
          internal = new URL(document.referrer).origin === window.location.origin;
        }
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!internal && !reduce) {
          document.documentElement.classList.add("is-preloading");
        }
      } catch (e) {
        /* Referrer nicht auswertbar — dann eben kein Preloader */
      }
    })();
  </script>
</head>
<body>

  <Preloader />

  <div class="scroll-progress" aria-hidden="true"></div>

  <Header />

  <main id="top">
    <slot />
  </main>

  <Footer />

  <StickyCta />

  <Lightbox />

  <!-- Scripts (lokal). Vendor-Stack nur auf Seiten mit Animationen; -->
  <!-- main.js faengt das Fehlen ueber hasGsap / typeof Lenis ab.    -->
  {vendorScripts && (
    <>
      <script is:inline src="/assets/vendor/lenis.min.js"></script>
      <script is:inline src="/assets/vendor/gsap.min.js"></script>
      <script is:inline src="/assets/vendor/ScrollTrigger.min.js"></script>
      <script is:inline src="/assets/vendor/SplitText.min.js"></script>
    </>
  )}
  <script is:inline src="/js/main.js"></script>
</body>
</html>
