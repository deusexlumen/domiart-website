---
---
<!-- Lightbox -->
<div class="lightbox" role="dialog" aria-modal="true" aria-label="Bildansicht">
  <button class="lightbox__close" aria-label="Schließen">&times;</button>
  <button class="lightbox__nav lightbox__nav--prev" aria-label="Vorheriges Bild">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
  </button>
  <!-- src wird erst beim Oeffnen gesetzt; ein leeres src laedt sonst  -->
  <!-- die Seite selbst ein zweites Mal.                               -->
  <!-- impeccable-disable-next-line broken-image -- kein src ist hier absichtlich, wird per JS gesetzt -->
  <img alt="">
  <button class="lightbox__nav lightbox__nav--next" aria-label="Nächstes Bild">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
  </button>
</div>
