<!-- ================= Preloader ================= -->
<!-- Sichtbar nur wenn <html> die Klasse .is-preloading traegt (Inline-  -->
<!-- Skript in Base.astro setzt sie beim ersten Aufruf pro Session).     -->
<div class="preloader" data-preloader aria-hidden="true">
  <div class="preloader__inner">
    <img class="preloader__emblem" src="/assets/img/domiart-emblem-weiss.png" alt="" width="282" height="100" fetchpriority="high">
    <img class="preloader__wortmarke" src="/assets/img/domiart-wortmarke-weiss.png" alt="" width="505" height="64" fetchpriority="high">
  </div>
</div>
